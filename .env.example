NEXT_PUBLIC_DJANGO_API_BASE_URL=http://127.0.0.1:8000

# Use any normal SMTP mailbox here, for example Gmail with an app password.
# If these are left empty, the admin mailer will also try the backend env file at
# gvssbackend/gvssbackend/.env using EMAIL_HOST / EMAIL_HOST_USER / EMAIL_HOST_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@example.com

# Optional: leave empty to allow any valid admin email address.
# Example: ADMIN_ALLOWED_EMAIL_DOMAINS=gmail.com,outlook.com
ADMIN_ALLOWED_EMAIL_DOMAINS=
