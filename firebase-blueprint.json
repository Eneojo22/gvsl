{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "A project or item in the portfolio, homes gallery or furniture showcase.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "image": { "type": "string" },
        "category": { "type": "string" },
        "location": { "type": "string" },
        "size": { "type": "string" },
        "type": { "type": "string", "enum": ["portfolio", "home", "furniture"] },
        "before": { "type": "string" },
        "after": { "type": "string" },
        "portfolioType": { "type": "string" },
        "client": { "type": "string" },
        "testimonial": { "type": "string" },
        "price": { "type": "string" },
        "promoPrice": { "type": "string" },
        "dimensions": { "type": "string" },
        "material": { "type": "string" },
        "condition": { "type": "string" },
        "isFurniture": { "type": "boolean" },
        "isRoom": { "type": "boolean" },
        "inStock": { "type": "boolean" },
        "colors": { "type": "string" },
        "tower": { "type": "string" },
        "rentBuy": { "type": "string" },
        "unitType": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Users with administrative privileges.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin"] }
      },
      "required": ["email"]
    },
    "Lead": {
      "title": "Lead",
      "description": "Client design inquiries and leads",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "projectType": { "type": "string", "enum": ["furniture", "home", "portfolio"] },
        "description": { "type": "string" },
        "measurements": { "type": "string" },
        "status": { "type": "string", "enum": ["new", "contacted", "quoted", "closed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "description"]
    }
  },
  "firestore": {
    "projects": {
      "schema": "Project",
      "description": "All projects managed via the admin portal."
    },
    "admins": {
      "schema": "Admin",
      "description": "List of authorized administrators."
    },
    "leads": {
      "schema": "Lead",
      "description": "Inquiries and leads submitted by users."
    }
  }
}
